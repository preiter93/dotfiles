# For a (much) more advanced configuration example see the dotfiles:
# https://github.com/FelixKratz/dotfiles
#
# Reload: sketchybar --reload

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

# Bar Appearance (Fixed Solid Background)
sketchybar --bar position=top   \
                 sticky=on      \
                 height=40      \
                 blur_radius=0  \
                 color=0xff1e1e2e

# Changing Defaults
default=(
  padding_left=5
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Regular:16.0"
  label.font="JetBrainsMono Nerd Font:Regular:15.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=8
  icon.padding_right=8
  label.padding_left=4
  label.padding_right=8
)
sketchybar --default "${default[@]}"

# Adding Left Items
source $ITEM_DIR/aerospace.sh
source $ITEM_DIR/chevron.sh
source $ITEM_DIR/front_app.sh
source $ITEM_DIR/tt.sh

# Adding Right Items
source $ITEM_DIR/clock.sh
source $ITEM_DIR/volume.sh
source $ITEM_DIR/battery.sh

# Force all scripts to run the first time
sketchybar --update
